# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000
# MongoDB Atlas connection string (replace user, password and cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus-lost-found?retryWrites=true&w=majority
# Any long random text. Used to sign login tokens.
JWT_SECRET=replace_this_with_a_long_random_string
# Frontend address(es) allowed to call this API. Separate several with commas.
CLIENT_URL=http://localhost:5173
